#!/usr/bin/env bash
set -euo pipefail

# Resolve symlinked launchers without depending on GNU realpath/readlink -f.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  BASE="$(cd -P -- "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink -- "$SOURCE")"
  [[ "$SOURCE" = /* ]] || SOURCE="$BASE/$SOURCE"
done
PROJECT_ROOT="$(cd -P -- "$(dirname -- "$SOURCE")/.." && pwd)"
RUNTIME="$PROJECT_ROOT/dist/runtime"

if [[ ! -f "$RUNTIME/index.js" || ! -x "$RUNTIME/exec-daemon" ]]; then
  printf '%s\n' 'Runtime has not been built. Run npm run build from the project directory.' >&2
  exit 1
fi
if [[ ! -x "$RUNTIME/node" ]]; then
  printf '%s\n' 'dist/runtime/node is missing. Run npm run provision, then npm run doctor. See docs/runtime.md.' >&2
  exit 1
fi
exec "$RUNTIME/exec-daemon" "$@"
