{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": [
      "ES2022",
      "ESNext.Disposable"
    ],
    "types": [
      "node"
    ],
    "strict": true,
    "skipLibCheck": false,
    "verbatimModuleSyntax": true,
    "allowJs": false,
    "noEmitOnError": true,
    "rootDir": ".",
    "outDir": "dist/project",
    "sourceMap": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.cts",
    "tools/**/*.ts",
    "tests/**/*.ts"
  ],
  "exclude": [
    "vendor",
    "dist",
    "node_modules",
    ".work"
  ]
}
