* text=auto
*.ts text eol=lf
*.cts text eol=lf
*.json text eol=lf
*.md text eol=lf
bin/* text eol=lf
# These must come last: generic extension rules also match vendor paths.
# Preserve all imported bytes exactly.
vendor/exec-daemon-runtime/** -text -diff !eol
runtime-tools/**/linux-x64/** -text -diff !eol
runtime-tools/origin/linux-x64/origin filter=lfs diff=lfs merge=lfs -text
runtime-tools/agent-store/linux-x64/cursor-agent-store-fuse filter=lfs diff=lfs merge=lfs -text
runtime-tools/tmux-root/linux-x64/tmux-root.tar filter=lfs diff=lfs merge=lfs -text
